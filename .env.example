# Load explicitly with: node --env-file=.env src/cli.ts agent-apply JOB_ID
OPENAI_API_KEY=
OPENAI_MODEL=
# Enter current standard input/output prices for the chosen model, USD per million tokens.
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
AGENT_MAX_STEPS=40
AGENT_MAX_REPEATED_ACTIONS=2
AGENT_MAX_TOKENS=120000
AGENT_MAX_USD=1
AGENT_MAX_OUTPUT_TOKENS=1500
AGENT_MIN_FIT_SCORE=50
AGENT_SCREENSHOTS=0
# Optional explicitly trusted additional employer origins, comma-separated. Never page-supplied.
AGENT_ALLOWED_ORIGINS=
# Optional exact, independently verified non-final draft/upload request URLs; never final-submit endpoints.
AGENT_ALLOWED_DRAFT_URLS=
